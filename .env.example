GROQ_API_KEY=TU_LLAVE_AQUI

# ElevenLabs API Key (Opcional para voz premium)
ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxx
ELEVENLABS_VOICE_ID=pNInz6obpgDQGcFmaJgB

# Seguridad (Acceso privado)
